{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "timestamp" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["uid", "email", "updatedAt", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "User project with files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "files": {
          "type": "array",
          "description": "Array of project files"
        },
        "updatedAt": { "type": "string", "format": "timestamp" },
        "createdAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["id", "userId", "name", "files", "updatedAt", "createdAt"]
    },
    "CollabSession": {
      "title": "Collaboration Session",
      "description": "Real-time collaborative project editing session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "hostId": { "type": "string" },
        "hostName": { "type": "string" },
        "activeFileId": { "type": "string" },
        "files": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "hostId", "files", "createdAt", "updatedAt"]
    },
    "CollabParticipant": {
      "title": "Session Participant",
      "description": "Participant in a collaborative editing session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "isHost": { "type": "boolean" },
        "activeFileId": { "type": "string" },
        "cursorLine": { "type": "number" },
        "cursorCol": { "type": "number" },
        "selectionText": { "type": "string" },
        "lastActive": { "type": "number" }
      },
      "required": ["id", "name", "color", "lastActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/collab_sessions/{sessionId}": {
      "schema": "CollabSession",
      "description": "Collaborative project sessions"
    },
    "/collab_sessions/{sessionId}/participants/{participantId}": {
      "schema": "CollabParticipant",
      "description": "Real-time participant presence and cursors"
    }
  }
}
